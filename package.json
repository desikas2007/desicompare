{
  "name": "foodcompare",
  "version": "1.0.0",
  "private": true,
  "description": "FoodCompare - Your Favorite Food. The Best Price. One Place.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "frontend",
    "backend"
  ],
  "scripts": {
    "build:shared": "npm run build -w @foodcompare/shared-types",
    "build:api": "npm run build -w @foodcompare/api",
    "build:web": "npm run build -w @foodcompare/web",
    "build": "npm run build:shared && npm run build:api && npm run build:web",
    "dev:api": "npm run start:dev -w @foodcompare/api",
    "dev:web": "npm run dev -w @foodcompare/web",
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "lint": "npm run lint -w @foodcompare/api && npm run lint -w @foodcompare/web",
    "typecheck": "npm run typecheck -w @foodcompare/api && npm run typecheck -w @foodcompare/web",
    "test": "npm run test -w @foodcompare/api",
    "test:e2e": "npm run test:e2e -w @foodcompare/api",
    "test:web": "npm run test -w @foodcompare/web",
    "seed": "npm run seed -w @foodcompare/api",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "prettier": "^3.2.5"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
