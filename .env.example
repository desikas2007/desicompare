# Application
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
API_GLOBAL_PREFIX=api/v1

# Database (MongoDB Atlas or local MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/foodcompare

# Authentication secrets - CHANGE THESE IN PRODUCTION
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters-long
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Auth behaviour
AUTH_COOKIE_NAME=fc_refresh
COOKIE_SECRET=change-me-cookie-secret-min-32-characters-long
ALLOW_REGISTRATION=true
REQUIRE_EMAIL_VERIFICATION=false

# Email (optional - password reset / verification)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=FoodCompare <no-reply@foodcompare.local>

# Provider integrations
# demo  = deterministic labelled sample data (default, no credentials needed)
# live  = use configured authorized provider integrations
PROVIDER_INTEGRATION_MODE=demo

# Rate limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=120

# Logging
LOG_LEVEL=info
